<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="StationVT"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
StationVT
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="StationVT">
        <sdx:configuration sdx:name="StationVT"
                           sdx:displayName="StationVT"
                           sdx:defaultProcessorGroup="ps7_cortexa9_1"
                           sdx:runtimes="cpp">
            <sdx:description>StationVT</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif=""
                            sdx:imageData=""
                            sdx:readme="StationVT/boot/generic.readme"
                            sdx:qemuArguments="StationVT/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="freertos10_xilinx_domain"
                            sdx:bif="StationVT/boot/StationVT.bif"
                            sdx:readme="StationVT/boot/generic.readme"
                            sdx:qemuArguments="StationVT/freertos10_xilinx_domain/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="ps7_cortexa9_1"
                            sdx:bif="StationVT/boot/StationVT.bif"
                            sdx:readme="StationVT/boot/generic.readme"
                            sdx:qemuArguments="StationVT/ps7_cortexa9_1/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="freertos10_xilinx_domain"
                                sdx:displayName="freertos10_xilinx on ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="freertos10_xilinx"
                        sdx:displayName="freertos10_xilinx"
                        sdx:bspLibraryPaths="StationVT/freertos10_xilinx_domain/bsplib/lib"
                        sdx:bspIncludePaths="StationVT/freertos10_xilinx_domain/bspinclude/include"
                        sdx:bspConfig="StationVT/freertos10_xilinx_domain/system.mss"
                />
            </sdx:processorGroup>
            <sdx:processorGroup sdx:name="ps7_cortexa9_1"
                                sdx:displayName="ps7_cortexa9_1"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_1">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="StationVT/ps7_cortexa9_1/bsplib/lib"
                        sdx:bspIncludePaths="StationVT/ps7_cortexa9_1/bspinclude/include"
                        sdx:bspConfig="StationVT/ps7_cortexa9_1/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
